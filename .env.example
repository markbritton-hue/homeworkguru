# Google Gemini API key (server-side only — never expose to the client)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Firebase Admin SDK service account JSON (stringified)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STUDENT=price_...
STRIPE_PRICE_SCHOLAR=price_...
STRIPE_PRICE_UNLIMITED=price_...

# Public base URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# App version (optional)
NEXT_PUBLIC_APP_VERSION=0.0.1
